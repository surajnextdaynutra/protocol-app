{
  "name": "protocol-rx-app",
  "private": true,
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "remix-serve ./build/server/index.js",
    "docker-start": "npm run start",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "vite": "vite",
    "smoke": "vite-node -c tools/vite.smoke.config.js tools/smoke.mjs",
    "theme:retarget": "node tools/retarget-theme.mjs",
    "local": "npm run build && node --env-file=.env ./node_modules/@remix-run/serve/dist/cli.js ./build/server/index.js"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@remix-run/dev": "^2.16.1",
    "@remix-run/fs-routes": "^2.16.1",
    "@remix-run/node": "^2.16.1",
    "@remix-run/react": "^2.16.1",
    "@remix-run/serve": "^2.16.1",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^12.0.0",
    "@shopify/shopify-app-remix": "^6.0.2",
    "@shopify/shopify-app-session-storage-mongodb": "^8.0.1",
    "isbot": "^5.1.0",
    "mongoose": "^8.9.0",
    "node-cron": "^3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@remix-run/eslint-config": "^2.16.1",
    "@remix-run/route-config": "^2.16.1",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^10.0.1",
    "mongodb-memory-server": "^10.4.3",
    "prettier": "^3.2.4",
    "vite": "^6.2.2",
    "vite-node": "^3.2.4"
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "minimatch": "9.0.5",
    "vite": "^6.2.2"
  }
}
